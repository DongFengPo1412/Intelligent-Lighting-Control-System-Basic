#include "asr.h"
extern "C"{ void * __dso_handle = 0 ;}
#include "setup.h"
#include "myLib/asr_ws2812.h"
#include "HardwareSerial.h"

WS2812 ASR_WS2812_2(2);

bool gameStarted = false;
bool gameOver = false;

int snakeX[256] = {4};
int snakeY[256] = {4};
int snakeLength = 1;
int dx = 1, dy = 0;

int foodX = 2, foodY = 2;
int score = 0;

// 坐标(x, y)映射到级联灯光的实际像素索引
int getPixelIndex(int x, int y) {
  // 每个小板 8x8，总大矩阵 16x16
  int blockX = x / 8; // 0 或 1
  int blockY = y / 8; // 0 或 1
  int localX = x % 8;
  int localY = y % 8;

  // 计算每个小板的偏移
  int blockOffset = 0;
  if (blockX == 0 && blockY == 0) blockOffset = 0;         // 左上（1）
  else if (blockX == 1 && blockY == 0) blockOffset = 64;   // 右上（2）
  else if (blockX == 0 && blockY == 1) blockOffset = 128;  // 左下（3）
  else if (blockX == 1 && blockY == 1) blockOffset = 192;  // 右下（4）

  return blockOffset + localY * 8 + localX;
}

bool isOnSnake(int x, int y) {
  for (int i = 0; i < snakeLength; i++) {
    if (snakeX[i] == x && snakeY[i] == y) return true;
  }
  return false;
}

void generateFood() {
  while (true) {
    foodX = rand() % 16;
    foodY = rand() % 16;
    if (!isOnSnake(foodX, foodY)) break;
  }
}

void drawSnake() {
  ASR_WS2812_2.pixel_clear();

  // 食物：红色
  int foodIndex = getPixelIndex(foodX, foodY);
  ASR_WS2812_2.pixel_set_color(foodIndex, 255, 0, 0);

  // 蛇
  for (int i = 0; i < snakeLength; i++) {
    int index = getPixelIndex(snakeX[i], snakeY[i]);
    if (i == 0)
      ASR_WS2812_2.pixel_set_color(index, 0, 255, 0);  // 头：绿色
    else
      ASR_WS2812_2.pixel_set_color(index, 0, 100, 0);  // 身：深绿
  }

  ASR_WS2812_2.pixel_show();
}

void flashRed() {
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 256; j++) {
      ASR_WS2812_2.pixel_set_color(j, 255, 0, 0);  // 全红
    }
    ASR_WS2812_2.pixel_show();
    delay(300);
    ASR_WS2812_2.pixel_clear();
    ASR_WS2812_2.pixel_show();
    delay(300);
  }
}

void showScore() {
  Serial.print("Game Over! Your Score: ");
  Serial.println(score);
}

void resetGame() {
  snakeLength = 3;
  snakeX[0] = 4; snakeY[0] = 4;
  snakeX[1] = 3; snakeY[1] = 4;
  snakeX[2] = 2; snakeY[2] = 4;
  dx = 1; dy = 0;
  generateFood();
  score = 0;
  gameStarted = true;
  gameOver = false;
}

void moveSnake() {
  int tailX = snakeX[snakeLength - 1];
  int tailY = snakeY[snakeLength - 1];

  for (int i = snakeLength - 1; i > 0; i--) {
    snakeX[i] = snakeX[i - 1];
    snakeY[i] = snakeY[i - 1];
  }

  snakeX[0] += dx;
  snakeY[0] += dy;

  // 穿墙（循环）
  if (snakeX[0] < 0) snakeX[0] = 15;
  if (snakeX[0] > 15) snakeX[0] = 0;
  if (snakeY[0] < 0) snakeY[0] = 15;
  if (snakeY[0] > 15) snakeY[0] = 0;

  // 撞自己判定
  for (int i = 1; i < snakeLength; i++) {
    if (snakeX[0] == snakeX[i] && snakeY[0] == snakeY[i]) {
      gameStarted = false;
      gameOver = true;
      flashRed();
      showScore();
      return;
    }
  }

  // 吃食物
  if (snakeX[0] == foodX && snakeY[0] == foodY) {
    snakeX[snakeLength] = tailX;
    snakeY[snakeLength] = tailY;
    snakeLength++;
    if (snakeLength > 256) snakeLength = 256;
    generateFood();
    score++;
  }

  drawSnake();
}

void UART_RX() {
  while (1) {
    while (Serial.available() > 0) {
      char ch = Serial.read();

      if (!gameStarted && ch == 'E') {
        resetGame();  // 开始或重启游戏
      } else if (gameStarted) {
        if (ch == 'W' && dy != 1) { dx = 0; dy = -1; }
        else if (ch == 'S' && dy != -1) { dx = 0; dy = 1; }
        else if (ch == 'A' && dx != 1) { dx = -1; dy = 0; }
        else if (ch == 'D' && dx != -1) { dx = 1; dy = 0; }
      }
    }
    delay(2);
  }
  vTaskDelete(NULL);
}

void app() {
  while (1) {
    if (gameStarted) {
      moveSnake();
    }
    delay(300);  // 可调速度
  }
  vTaskDelete(NULL);
}

void hardware_init() {
  ASR_WS2812_2.pixel_init(256);
  setPinFun(13, SECOND_FUNCTION);  // TX
  setPinFun(14, SECOND_FUNCTION);  // RX
  Serial.begin(115200);

  xTaskCreate(UART_RX, "UART_RX", 256, NULL, 4, NULL);
  xTaskCreate(app, "app", 256, NULL, 4, NULL);

  vTaskDelete(NULL);
}

void setup() {
  // 无语音识别设置
}

uint32_t snid = 0;

extern "C" void ASR_CODE() {
  // 空
}
