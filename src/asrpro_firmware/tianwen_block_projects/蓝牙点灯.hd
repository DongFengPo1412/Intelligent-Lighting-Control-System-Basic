#include "asr.h"
extern "C"{ void * __dso_handle = 0 ;}
#include "setup.h"
#include "myLib/asr_ws2812.h"
#include "HardwareSerial.h"

uint32_t snid;
String Rec;

// 串口接收线程
void UART_RX();
// 主循环线程（保留）
void app();
// 语音识别触发函数
void ASR_CODE();

// WS2812 控制对象（Pin 2）
WS2812 ASR_WS2812_2(2);

// ========== 串口控制线程 ==========
void UART_RX() {
  while (1) {
    if (Serial.available() > 0) {
      Rec = Serial.readString();
      if (Rec == "on") {
        ASR_WS2812_2.setBrightness(50);
        ASR_WS2812_2.pixel_set_all_color(255, 255, 255);  // 白灯全亮
        ASR_WS2812_2.pixel_show();
      }
      else if (Rec == "off") {
        ASR_WS2812_2.pixel_set_all_color(0, 0, 0);  // 全灭
        ASR_WS2812_2.pixel_show();
      }
    }
    delay(2);
  }
  vTaskDelete(NULL);
}

// ========== 语音识别控制 ==========
void ASR_CODE() {
  switch (snid) {
    case 1: // 红灯
      ASR_WS2812_2.setBrightness(50);
      ASR_WS2812_2.pixel_set_all_color(255, 0, 0);
      ASR_WS2812_2.pixel_show();
      break;
    case 2: // 蓝灯
      ASR_WS2812_2.setBrightness(50);
      ASR_WS2812_2.pixel_set_all_color(0, 0, 255);
      ASR_WS2812_2.pixel_show();
      break;
    case 3: // 绿灯
      ASR_WS2812_2.setBrightness(50);
      ASR_WS2812_2.pixel_set_all_color(0, 255, 0);
      ASR_WS2812_2.pixel_show();
      break;
    case 4: // 关灯
      ASR_WS2812_2.pixel_set_all_color(0, 0, 0);
      ASR_WS2812_2.pixel_show();
      break;
  }
}

// ========== 系统主线程 ==========
void app() {
  while (1) {
    delay(100);
  }
  vTaskDelete(NULL);
}

// ========== 操作系统启动后初始化 ==========
void hardware_init() {
  vol_set(1);
  ASR_WS2812_2.pixel_init(64);

  setPinFun(13, SECOND_FUNCTION);  // TX
  setPinFun(14, SECOND_FUNCTION);  // RX
  Serial.begin(9600);

  // 创建线程任务
  xTaskCreate(UART_RX, "UART_RX", 128, NULL, 4, NULL);
  xTaskCreate(app, "app", 128, NULL, 4, NULL);

  vTaskDelete(NULL);
}

// ========== 操作系统启动前初始化 ==========
void setup() {
  // 语音指令配置示例：
  // {ID:0,keyword:"唤醒词",ASR:"天问五幺",ASRTO:"我在"}
  // {ID:1,keyword:"命令词",ASR:"打开红灯",ASRTO:"好的，马上执行"}
  // {ID:2,keyword:"命令词",ASR:"打开蓝灯",ASRTO:"好的，马上执行"}
  // {ID:3,keyword:"命令词",ASR:"打开绿灯",ASRTO:"好的，马上执行"}
  // {ID:4,keyword:"命令词",ASR:"关闭灯光",ASRTO:"好的，马上执行"}
}


