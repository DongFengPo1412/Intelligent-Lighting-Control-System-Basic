#include "asr.h"
extern "C"{ void * __dso_handle = 0 ;}
#include "setup.h"
#include "myLib/asr_ws2812.h"

uint32_t snid;
uint8_t var;
void ASR_CODE();

//{speak:小蝶-清新女声,vol:2,speed:10,platform:haohaodada}
//{playid:10001,voice:欢迎使用语音助手，用语音助手唤醒我。}
//{playid:10002,voice:我退下了，用语音助手唤醒我}

WS2812 ASR_WS2812_2(2);

volatile bool music_playing = false; // 是否在律动模式

/*描述该功能:
 * 根据语音识别的snid执行不同动作：
 * snid=1 播放音乐，LED随机柱状律动
 * snid=2 停止播放，LED熄灭
 */
void ASR_CODE(){
  switch (snid) {
    case 1:
      music_playing = true;  // 进入律动模式
      ASR_WS2812_2.setBrightness(50);
      while (music_playing) {  // 一直律动直到 music_playing 变为 false
        for (int x = 0; x < 16; x++) {
          int height = rand() % 17; // 随机高度0-16
          uint8_t r = rand() % 256;
          uint8_t g = rand() % 256;
          uint8_t b = rand() % 256;
          for (int y = 0; y < 16; y++) {
            if (y < height) {
              ASR_WS2812_2.pixel_set_color(y * 16 + x, r, g, b);
            } else {
              ASR_WS2812_2.pixel_set_color(y * 16 + x, 0, 0, 0);
            }
          }
        }
        ASR_WS2812_2.pixel_show();
        vTaskDelay(200 / portTICK_PERIOD_MS);
      }
      break;

    case 2:
      music_playing = false;  // 退出律动模式
      ASR_WS2812_2.pixel_set_all_color(0,0,0);
      ASR_WS2812_2.pixel_show();
      break;
  }
}

void hardware_init(){
  vol_set(1);
  ASR_WS2812_2.pixel_init(256);  // 初始化256颗灯
  vTaskDelete(NULL);
}

void setup()
{
  //{ID:0,keyword:"唤醒词",ASR:"语音助手",ASRTO:"我在"}
  //{ID:1,keyword:"命令词",ASR:"播放音乐",ASRTO:"好的，马上播放"}
  //{ID:2,keyword:"命令词",ASR:"停止播放",ASRTO:"好的"}
}

