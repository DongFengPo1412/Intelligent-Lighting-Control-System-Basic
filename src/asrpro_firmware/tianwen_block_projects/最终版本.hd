WS2812 ASR_WS2812_2(2);

void displaycolorfulPattern(const unsigned char r[16][16],const unsigned char g[16][16],const unsigned char b[16][16])
{
  ASR_WS2812_2.setBrightness(5);
  ASR_WS2812_2.pixel_set_all_color(0, 0, 0); // 先清空所有 LED
  for (int y = 1; y <= 8; y++) 
  {
    for (int x = 1; x <= 8; x++) 
    {
      { // 注意位顺序可能需要调整
        int index = (y - 1) * 8 + x - 1;
        ASR_WS2812_2.pixel_set_color(index, r[y][x], g[y][x], b[y][x]);
      }
    }
  }
  for (int y = 1; y <= 8; y++) 
  {
    for (int x = 9; x <= 16; x++) 
    {
      { // 注意位顺序可能需要调整
        int index = (y - 1) * 8 + x - 8 + 63;
        ASR_WS2812_2.pixel_set_color(index, r[y][x], g[y][x], b[y][x]);
      }
    }
  }
  for (int y = 9; y <= 16; y++) 
  {
    for (int x = 1; x <= 8; x++)  
    {
      { // 注意位顺序可能需要调整
        int index = (y - 9) * 8 + x + 127;
        ASR_WS2812_2.pixel_set_color(index, r[y][x], g[y][x], b[y][x]);
      }
    }
  }
  for (int y = 9; y <= 16; y++)  
  {
    for (int x = 9; x <= 16; x++) 
    {
      { // 注意位顺序可能需要调整
        int index = (y - 9) * 8 + x - 8 + 191;
        ASR_WS2812_2.pixel_set_color(index, r[y][x], g[y][x], b[y][x]);
      }
    }
  }
  ASR_WS2812_2.pixel_show();
}
// 显示16x16图案的函数
void displayPattern(const uint16_t pattern[16], uint8_t r, uint8_t g, uint8_t b) 
{
  ASR_WS2812_2.setBrightness(50);
  ASR_WS2812_2.pixel_set_all_color(0, 0, 0); // 先清空所有 LED
  for (int y = 0; y < 16; y++) 
  {
    for (int x = 0; x < 16; x++) 
    {
      if (pattern[y] & (1 << (15 - x))) 
      { // 注意位顺序可能需要调整
        int index = y * 16 + x;
        ASR_WS2812_2.pixel_set_color(index, r, g, b);
      }
    }
  }
  ASR_WS2812_2.pixel_show();
}

void displaySpeaking1Animation() 
{
  uint8_t frameDelay[] = {100, 500, 500, 500}; // 各帧持续时间（毫秒）
  
  for (int i = 0; i < 4; i++) {
    displayPattern(wake_frames[i], 0, 255, 0); // 绿色显示
    delay(frameDelay[i]);
  }
}

void displaySpeaking2Animation() 
{
  uint8_t frameDelay[] = {100, 500, 500, 300, 500, 500, 500, 500, 300} ;// 各帧持续时间（毫秒）
  
  for (int i = 0; i < 9; i++) {
    displayPattern(answer_frames[i], 0, 255, 0); // 绿色显示
    delay(frameDelay[i]);
  }
}

void displaycryAnimation() 
{
  uint8_t frameDelay[] = {500, 500, 500, 500}; // 各帧持续时间（毫秒）
  
  for (int i = 0; i < 4; i++) {
    displayPattern(cry_frames[i], 0, 0, 255); // 蓝色显示
    delay(frameDelay[i]);
  }
}

void displaySmileyAnimation() 
{
  uint8_t colors[][3] = {
    {255, 255, 0},   // 黄色
    {255, 128, 0},   // 橙色
    {255, 0, 0},     // 红色
    {0, 0, 255},     // 蓝色
  };
  
  for (int i = 0; i < 3; i++) // 循环3次动画
  { 
    // 显示不同表情和颜色
    for (int j = 0; j < 4; j++) 
    {
      displayPattern(expressions[j], colors[j][0], colors[j][1], colors[j][2]);
      delay(1000); // 每个表情显示1秒
    }
  }
}


void ASR_CODE()
{
  switch (snid) 
  {
   case 0: // 唤醒时触发嘴型动画
    displaySpeaking1Animation();
    break;
   case 1:// 新增一个 case 用于显示笑脸
    displayPattern(smile, 255, 255 ,0);
    break;
   case 2:// 新增一个 case 用于显示哭脸
    displaycryAnimation();
    break;
   case 3: // 新增一个 case 用于显示笑脸动画
    displaySmileyAnimation();
    break;
   case 4: // 新增一个 case 用于显示桌宠
    displaycolorfulPattern( red, green, blue);
    break;
   case 5:// 新增一个 case 用于关机
    displaySpeaking2Animation();
    ASR_WS2812_2.pixel_set_all_color(0,0,0);
    ASR_WS2812_2.pixel_show();
    break;
  }
}

void hardware_init()
{
  vol_set(1);
  ASR_WS2812_2.pixel_init(256); // 修改为256个LED，对应16x16矩阵
  vTaskDelete(NULL);
}

void setup()
{
  //{ID:0,keyword:"唤醒词",ASR:"吃豆人",ASRTO:"我在"}
  //{ID:1,keyword:"命令词",ASR:"显示笑脸",ASRTO:"哈哈哈哈哈"}
  //{ID:2,keyword:"命令词",ASR:"显示哭脸",ASRTO:"呜呜呜呜呜"}
  //{ID:3,keyword:"命令词",ASR:"变脸",ASRTO:"好的，请欣赏变脸表演"}
  //{ID:4,keyword:"命令词",ASR:"显示桌宠",ASRTO:"好的，小精灵来啦"}
  //{ID:5,keyword:"命令词",ASR:"关闭灯光",ASRTO:"好的，马上执行"}
  setPinFun(2,FIRST_FUNCTION);
  pinMode(2,input);
}

